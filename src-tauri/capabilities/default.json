{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for Axiom loopback desktop windows",
  "windows": ["main", "quick-capture", "note-*"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "dialog:default",
    "notification:default",
    "global-shortcut:default",
    "allow-desktop-info",
    "allow-desktop-backend-status",
    "allow-desktop-restart-backend",
    "allow-desktop-trigger-backup",
    "allow-desktop-get-prefs",
    "allow-desktop-save-prefs",
    "allow-desktop-read-state",
    "allow-desktop-write-state",
    "allow-desktop-delete-state",
    "allow-desktop-save-file",
    "allow-desktop-open-in-obsidian",
    "allow-desktop-open-in-vscode",
    "allow-desktop-reveal-in-explorer",
    "allow-desktop-open-in-browser",
    "allow-desktop-notify",
    "allow-desktop-set-tray-state",
    "allow-desktop-open-note-window",
    "allow-desktop-toggle-quick-overlay",
    "allow-desktop-focus-main-route",
    "allow-desktop-hide-quick-overlay",
    "allow-desktop-set-dirty-tabs",
    "allow-desktop-quit",
    "allow-desktop-check-updates",
    "allow-desktop-install-update"
  ]
}
