{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axiom",
  "version": "1.3.11",
  "identifier": "com.alexmollard.axiom",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "fallback-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Alex Mollard",
    "copyright": "Copyright (c) 2026 Alex Mollard. MIT License.",
    "license": "MIT",
    "homepage": "https://github.com/AlexMollard/Axiom",
    "category": "Productivity",
    "shortDescription": "Local Markdown memory workspace",
    "longDescription": "Axiom is a local Markdown memory workspace for people and coding agents, with a native Windows desktop app, search, a knowledge graph and an MCP server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
