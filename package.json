{
  "name": "axiom",
  "version": "1.3.10",
  "description": "Local Markdown memory workspace for people and coding agents",
  "license": "MIT",
  "author": "Alex Mollard",
  "homepage": "https://github.com/AlexMollard/Axiom#readme",
  "bugs": {
    "url": "https://github.com/AlexMollard/Axiom/issues"
  },
  "keywords": [
    "markdown",
    "knowledge-base",
    "memory",
    "mcp",
    "ai-agents",
    "tauri",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexMollard/Axiom.git"
  },
  "os": [
    "win32"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "axiom-memory": "./src/memory.mjs",
    "axiom-memory-mcp": "./integrations/mcp.mjs"
  },
  "scripts": {
    "start": "pwsh -NoProfile -File scripts/start.ps1",
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify:runtime": "pwsh -NoProfile -File scripts/verify-runtime.ps1",
    "benchmark:retrieval": "node scripts/benchmark-retrieval.mjs",
    "mcp": "node integrations/mcp.mjs",
    "setup:embeddings": "node scripts/setup-embeddings.mjs",
    "backup": "node src/memory.mjs backup",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:icons": "python scripts/build-icons.py",
    "desktop:pack": "pwsh -NoProfile -File scripts/pack-desktop.ps1",
    "desktop:install": "pwsh -NoProfile -File scripts/pack-desktop.ps1 -Install",
    "desktop:release": "pwsh -NoProfile -File scripts/pack-desktop.ps1 -Publish",
    "generate:icons": "node scripts/generate-lucide-catalog.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "diff": "8.0.4",
    "markdown-it": "14.3.3",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@uiw/react-codemirror": "4.25.12",
    "@vitejs/plugin-react": "6.1.2",
    "d3-force": "3.0.0",
    "lucide-react": "1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
